# SVSG 服务配置模板 —— 复制为 .env 后按需修改

# ---- 服务监听 ----
SVSG_HOST=127.0.0.1
SVSG_PORT=3002

# ---- L3 主控 LLM（真实后端走 openai，需同时给出 BASE_URL）----
SVSG_LLM_PROVIDER=openai
SVSG_LLM_BASE_URL=https://api.openai.com/v1
SVSG_LLM_API_KEY=sk-xxxx
SVSG_LLM_MODEL=gpt-4o-mini
SVSG_LLM_TIMEOUT_S=3.0

# ---- L1.5 视觉验证（必须严格小于 LLM_TIMEOUT_S 的 1/3）----
SVSG_L15_TIMEOUT_S=0.9

# ---- L1 检测器：stub=演示桩(无模型) | yolo=YOLOv8(需 .[ml]) ----
SVSG_DETECTOR=stub
SVSG_YOLO_WEIGHTS=yolov8n.pt

# ---- 可观测性 ----
SVSG_SAMPLE_MODE=steady
SVSG_TRACE_FILE=traces.jsonl
SVSG_LOG_LEVEL=INFO

# ---- 安全 / 网关入口（设置后所有 /v1/* 需携带 X-API-Key 头）----
SVSG_API_KEY=
SVSG_CORS_ORIGINS=[]
# SVSG_CORS_ORIGINS 逗号分隔时可用 JSON 数组：SVSG_CORS_ORIGINS=["https://a.com","https://b.com"]
# -- 登录机制 v0（可选）--
# SVSG_AUTH_ENABLED=1            # 启用后 /v1/* 需要 Bearer 令牌（/auth/* 提供注册/登录）
# SVSG_AUTH_DB=svsg_auth.db      # 用户/令牌库路径（建议启用时写绝对路径）
# SVSG_AUTH_TOKEN_TTL_S=604800   # 令牌有效期，默认 7 天
# SVSG_AUTH_PBKDF2_ITERS=200000  # 口令 PBKDF2 迭代次数
